ENVIRONMENT=development
SECRET_KEY=change_this_to_a_very_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
ENCRYPTION_KEY=change_this_to_a_32_byte_hex_string
FOOTYSTATS_API_KEY=your_footystats_api_key_here
DATABASE_URL=sqlite:///./data/cerveau.db
DATABASE_PATH=./data/cerveau.db
NOTIFICATION_VAPID_PUBLIC=your_vapid_public_key
NOTIFICATION_VAPID_PRIVATE=your_vapid_private_key
NOTIFICATION_VAPID_EMAIL=mailto:your@email.com
MAX_REQUESTS_PER_HOUR=1600
LOG_LEVEL=INFO
BACKUP_DIR=./data/backups
PORT=8000
